# ============================================================ 构建产物 / 缓存
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# ============================================================ 编译产物
tools/*.exe
tools/*.o
tools/*.obj
*.axf
*.hex
*.bin
*.map

# 工具脚本的输出目录（基准图/CSV、走查截图等，可随时重新生成）
tools/_ref_out/
tools/_v1_out/

# ============================================================ 工具链缓存（体积大）
# tools/toolchain 整个目录都是 x86 gcc 的下载缓存 + 解压副本，
# 接近 1 GB。需要时跑 tools/cross_check.py 会自动按需下载。
tools/toolchain/

# ============================================================ 临时文件
tools/_sfra_script.txt
tools/_t.txt
*.tmp
*.log

# 运行时崩溃日志（上位机崩溃时由 excepthook 生成）
sfra_crash.log

# 抓到的实测数据：体积不大但属于"每次都不一样"的产物，不入库
tools/*.csv
.workbuddy/
